{
  "manifest_version": 3,
  "name": "Quiet",
  "version": "1.0",
  "description": "Keep the sites you need. Lose the parts that eat you.",
  "default_locale": "en",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.instagram.com/*",
        "*://*.reddit.com/*",
        "*://*.linkedin.com/*",
        "*://*.facebook.com/*"
      ],
      "js": ["rules-engine.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.instagram.com/*",
    "*://*.reddit.com/*",
    "*://*.linkedin.com/*",
    "*://*.facebook.com/*"
  ]
}
