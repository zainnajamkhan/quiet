{
  "schemaVersion": 1,
  "rulesetVersion": 3,
  "updatedAt": "2026-09-07T00:00:00Z",
  "sites": [
    {
      "id": "youtube",
      "name": "YouTube",
      "matches": ["*://*.youtube.com/*"],
      "features": [
        {
          "id": "youtube.home-feed",
          "name": "Home page recommendation grid",
          "summary": "The wall of recommended videos on the YouTube home page.",
          "defaultEnabled": true,
          "appliesTo": ["/", "/?*"],
          "hide": ["ytd-rich-grid-renderer"],
          "verify": ["ytd-app"]
        },
        {
          "id": "youtube.shorts",
          "name": "Shorts shelves",
          "summary": "Shorts rows on the home page and in search results.",
          "defaultEnabled": true,
          "hide": ["ytd-reel-shelf-renderer", "ytd-rich-shelf-renderer[is-shorts]"],
          "verify": ["ytd-app"]
        },
        {
          "id": "youtube.up-next",
          "name": "Up next sidebar",
          "summary": "The recommended videos column beside a video.",
          "defaultEnabled": false,
          "hide": ["ytd-watch-next-secondary-results-renderer"],
          "verify": ["ytd-app"]
        },
        {
          "id": "youtube.comments",
          "name": "Comments",
          "defaultEnabled": false,
          "hide": ["#comments"],
          "verify": ["ytd-app"]
        }
      ]
    },
    {
      "id": "x",
      "name": "X (Twitter)",
      "matches": ["*://*.x.com/*", "*://*.twitter.com/*"],
      "features": [
        {
          "id": "x.sidebar",
          "name": "Trends and Who to follow sidebar",
          "summary": "The whole right hand column: trending topics and follow suggestions.",
          "defaultEnabled": true,
          "hide": ["[data-testid=\"sidebarColumn\"]"],
          "verify": ["[data-testid=\"primaryColumn\"]"]
        },
        {
          "id": "x.explore",
          "name": "Explore page contents",
          "summary": "Blanks out the Explore tab's content so opening it is a dead end.",
          "defaultEnabled": false,
          "appliesTo": ["/explore*"],
          "hide": ["[data-testid=\"primaryColumn\"] section"],
          "verify": ["[data-testid=\"primaryColumn\"]"]
        }
      ]
    },
    {
      "id": "linkedin",
      "name": "LinkedIn",
      "matches": ["*://*.linkedin.com/*"],
      "features": [
        {
          "id": "linkedin.feed",
          "name": "Home feed",
          "summary": "The scrolling post feed, leaving messaging, jobs and profiles usable.",
          "defaultEnabled": true,
          "appliesTo": ["/feed*", "/", "/?*"],
          "hide": [".scaffold-finite-scroll", ".scaffold-finite-scroll__content"],
          "verify": ["main"]
        },
        {
          "id": "linkedin.news",
          "name": "LinkedIn News and suggestions rail",
          "summary": "The right hand column with news and 'Add to your feed'.",
          "defaultEnabled": true,
          "hide": ["aside.scaffold-layout__aside"],
          "verify": ["main"]
        }
      ]
    },
    {
      "id": "reddit",
      "name": "Reddit",
      "matches": ["*://*.reddit.com/*"],
      "features": [
        {
          "id": "reddit.home-feed",
          "name": "Home feed",
          "summary": "The front page post list. Individual subreddits stay browsable.",
          "defaultEnabled": true,
          "appliesTo": ["/", "/?*"],
          "hide": ["shreddit-feed", "main shreddit-post"],
          "verify": ["shreddit-app"]
        },
        {
          "id": "reddit.related-posts",
          "name": "Related posts under a thread",
          "defaultEnabled": false,
          "hide": ["shreddit-comments-page-ad", "[data-testid=\"related-posts\"]"],
          "verify": ["shreddit-app"]
        }
      ]
    },
    {
      "id": "instagram",
      "name": "Instagram",
      "matches": ["*://*.instagram.com/*"],
      "features": [
        {
          "id": "instagram.reels-nav",
          "name": "Reels navigation link",
          "summary": "Removes the Reels entry point from the sidebar.",
          "defaultEnabled": true,
          "hide": ["a[href=\"/reels/\"]"],
          "verify": ["nav"]
        },
        {
          "id": "instagram.explore-nav",
          "name": "Explore navigation link",
          "defaultEnabled": true,
          "hide": ["a[href=\"/explore/\"]"],
          "verify": ["nav"]
        }
      ]
    },
    {
      "id": "facebook",
      "name": "Facebook",
      "matches": ["*://*.facebook.com/*"],
      "features": [
        {
          "id": "facebook.feed",
          "name": "News feed",
          "summary": "The main scrolling feed on the home page.",
          "defaultEnabled": true,
          "appliesTo": ["/", "/?*"],
          "hide": ["[role=\"feed\"]"],
          "verify": ["[role=\"banner\"]"]
        },
        {
          "id": "facebook.reels-nav",
          "name": "Reels and Marketplace links",
          "defaultEnabled": false,
          "hide": ["a[href^=\"/reel\"]", "a[href^=\"/marketplace\"]"],
          "verify": ["[role=\"banner\"]"]
        }
      ]
    }
  ]
}
